# Normalise line endings so Windows checkouts stop warning about CRLF.
# LF in the repository and in the working tree; CI runs on Linux either way.
* text=auto eol=lf

# Recipes need real tabs and LF.
test/Makefile text eol=lf

# Binary, never touch.
*.pdf binary
*.hex binary
*.elf binary

# Fixtures are measurements and are never rewritten -- test/fixtures/README.md
# says "do not edit", and silently converting their line endings is an edit.
# The VCDS export in particular is CRLF and cp1250 as the tool wrote it, and
# it is quoted byte-for-byte in the analysis. The slcan captures are already
# LF, so this pins what is true rather than changing anything.
test/fixtures/** -text
